{
  "name": "helios",
  "version": "0.0.1",
  "private": true,
  "description": "A framework-agnostic engine for programmatic video creation.",
  "author": "Gavin Bintz <me@gavinbintz.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BintzGavin/helios.git"
  },
  "license": "ELv2",
  "bugs": {
    "url": "https://github.com/BintzGavin/helios/issues"
  },
  "homepage": "https://github.com/BintzGavin/helios#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/player && npm run build -w packages/renderer && npm run build -w packages/studio && npm run build -w packages/cli",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test -w packages/core",
    "test:player": "npm run test -w packages/player",
    "test:renderer": "npm run test -w packages/renderer",
    "dev": "npx vite ./examples/simple-canvas-animation",
    "dev:react-dom": "vite serve examples/react-dom-animation",
    "dev:vue-dom": "vite serve examples/vue-dom-animation",
    "dev:threejs": "vite serve examples/threejs-canvas-animation",
    "dev:pixi": "vite serve examples/pixi-canvas-animation",
    "dev:d3": "vite serve examples/d3-animation",
    "build:examples": "vite build -c vite.build-example.config.js",
    "render:canvas-example": "npm run build:examples && npx tsx packages/renderer/scripts/render.ts",
    "verify:e2e": "npx tsx tests/e2e/verify-all.ts",
    "verify:release": "node --test tests/release-contract.test.mjs"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.29.2",
    "gsap": "^3.12.0",
    "lottie-web": "^5.13.0",
    "motion": "^12.36.0",
    "pixi.js": "^8.7.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "svelte": "^5.48.2",
    "three": "^0.182.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^7.1.2",
    "vitest": "^4.0.17",
    "vue": "^3.5.27"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  }
}
